{
  "name": "synapse-traceability",
  "displayName": "Requirement Traceability Engine",
  "description": "Edge-computed real-time requirement traceability, inline CodeLens, Cytoscape dependency graph, and pre-commit verification gate.",
  "version": "0.1.0",
  "publisher": "j26-se-309",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:typescript",
    "onCommand:rte.refreshTrace",
    "onCommand:rte.showTraceGraph",
    "onCommand:rte.precommitCheck",
    "onCommand:rte.scaffoldStoryFiles",
    "onView:rte.backlogView",
    "onView:rte.graphView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rte.refreshTrace",
        "title": "RTE: Refresh Traceability Analysis"
      },
      {
        "command": "rte.showTraceGraph",
        "title": "RTE: Show Trace Dependency Graph"
      },
      {
        "command": "rte.precommitCheck",
        "title": "RTE: Run Pre-Commit Verification Gate"
      },
      {
        "command": "rte.showStoryDetails",
        "title": "RTE: View Story Acceptance Criteria & Rationale"
      },
      {
        "command": "rte.scaffoldStoryFiles",
        "title": "RTE: Scaffold Code & Tests from User Story"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rte-explorer",
          "title": "Requirement Traceability",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "rte-explorer": [
        {
          "type": "webview",
          "id": "rte.backlogView",
          "name": "Sprint Backlog",
          "visibility": "visible"
        },
        {
          "type": "webview",
          "id": "rte.graphView",
          "name": "Active Traceability Sub-Graph",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Requirement Traceability Engine",
      "properties": {
        "rte.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of the local Requirement Traceability Engine backend API."
        },
        "rte.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline CodeLens decorations directly above function definitions."
        },
        "rte.autoDeltaOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Execute sub-350ms AST + Git delta trace analysis on file save."
        },
        "rte.confidenceHigh": {
          "type": "number",
          "default": 0.8,
          "description": "Cosine similarity threshold for verified link."
        },
        "rte.confidenceMedium": {
          "type": "number",
          "default": 0.65,
          "description": "Cosine similarity threshold for candidate link."
        },
        "rte.storiesPath": {
          "type": "string",
          "default": "C:/Users/DINUWA/Desktop/Reserach resources/Requirement-Traceability-Engine/.rte/stories.json",
          "description": "Path to the .rte/ directory or stories.json containing the active sprint backlog requirements."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "pnpm run clean && npm run compile"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "cytoscape": "^3.34.3",
    "typescript": "^5.9.0"
  }
}